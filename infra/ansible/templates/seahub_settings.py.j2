# Généré par playbooks/seafile.yml — ne pas éditer à la main.

# Étude 2.11 : force la connexion pour consulter tout lien de partage —
# complémentaire de l'interdiction de génération ci-dessous.
SHARE_LINK_LOGIN_REQUIRED = {{ seafile_share_link_login_required | title }}

# Permission par rôle — étude 2.11 : "la permission can_generate_share_link
# peut être désactivée par rôle [...] pour empêcher purement et simplement la
# génération de liens de partage par les utilisateurs concernés". Valeur par
# défaut ci-dessous ; affiner par rôle (ex: "guest") en recette selon les
# profils de consultants.
ENABLE_SHARE_LINK = {{ seafile_can_generate_share_link_default | title }}

# Connecteur OnlyOffice — étude 1.5 : intégration officielle documentée par
# Seafile lui-même (paramètre OFFICE_SERVER_TYPE, protocole WOPI).
ENABLE_ONLYOFFICE = True
OFFICE_SERVER_TYPE = '{{ seafile_office_server_type }}'
ONLYOFFICE_APIJS_URL = '{{ seafile_onlyoffice_url }}/web-apps/apps/api/documents/api.js'
ONLYOFFICE_FILE_EXTENSION = ('docx', 'xlsx', 'pptx', 'doc', 'xls', 'ppt', 'odt', 'ods', 'odp')
ONLYOFFICE_EDIT_FILE_EXTENSION = ('docx', 'xlsx', 'pptx')

# SSO OIDC vers Keycloak — étude 1.7 (client "seafile" créé par le rôle
# keycloak_realm).
ENABLE_OAUTH = True
OAUTH_CLIENT_ID = "seafile"
OAUTH_PROVIDER_DOMAIN = "{{ open365_domain }}"
OAUTH_AUTHORIZATION_URL = "{{ keycloak_base_url }}/realms/{{ keycloak_target_realm }}/protocol/openid-connect/auth"
OAUTH_TOKEN_URL = "{{ keycloak_base_url }}/realms/{{ keycloak_target_realm }}/protocol/openid-connect/token"
OAUTH_USER_INFO_URL = "{{ keycloak_base_url }}/realms/{{ keycloak_target_realm }}/protocol/openid-connect/userinfo"
OAUTH_REDIRECT_URL = "https://{{ seafile_domain }}/oauth/callback/"
OAUTH_SCOPE = ["openid", "profile", "email"]
