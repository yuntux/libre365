# Generated by playbooks/seafile.yml — do not edit by hand.

# Study 2.11: forces login to view any share link — complementary to the
# generation ban below.
SHARE_LINK_LOGIN_REQUIRED = {{ seafile_share_link_login_required | title }}

# Per-role permission — study 2.11: "the can_generate_share_link permission
# can be disabled per role [...] to purely and simply prevent share link
# generation by the users concerned". Default value below; refine per role
# (e.g. "guest") during staging depending on consultant profiles.
ENABLE_SHARE_LINK = {{ seafile_can_generate_share_link_default | title }}

# OnlyOffice connector — study 1.5: official integration documented by
# Seafile itself (OFFICE_SERVER_TYPE parameter, WOPI protocol).
ENABLE_ONLYOFFICE = True
OFFICE_SERVER_TYPE = '{{ seafile_office_server_type }}'
ONLYOFFICE_APIJS_URL = '{{ seafile_onlyoffice_url }}/web-apps/apps/api/documents/api.js'
ONLYOFFICE_FILE_EXTENSION = ('docx', 'xlsx', 'pptx', 'doc', 'xls', 'ppt', 'odt', 'ods', 'odp')
ONLYOFFICE_EDIT_FILE_EXTENSION = ('docx', 'xlsx', 'pptx')

# OIDC SSO toward Keycloak — study 1.7 ("seafile" client created by the
# keycloak_realm role).
ENABLE_OAUTH = True
OAUTH_CLIENT_ID = "seafile"
OAUTH_PROVIDER_DOMAIN = "{{ libre365_domain }}"
OAUTH_AUTHORIZATION_URL = "{{ keycloak_base_url }}/realms/{{ libre365_keycloak_realm_name }}/protocol/openid-connect/auth"
OAUTH_TOKEN_URL = "{{ keycloak_base_url }}/realms/{{ libre365_keycloak_realm_name }}/protocol/openid-connect/token"
OAUTH_USER_INFO_URL = "{{ keycloak_base_url }}/realms/{{ libre365_keycloak_realm_name }}/protocol/openid-connect/userinfo"
OAUTH_REDIRECT_URL = "https://{{ seafile_domain }}/oauth/callback/"
OAUTH_SCOPE = ["openid", "profile", "email"]
