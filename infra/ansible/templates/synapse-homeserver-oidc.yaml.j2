# Excerpt of homeserver.yaml generated by playbooks/matrix.yml — to be
# merged with the rest of the Synapse configuration carried by the Helm
# chart (out of scope for this task). Study 1.2: Matrix chosen for its
# Tchap/DINUM alignment and SSO maturity (unlike Dendrite, ruled out for
# lack of native SSO/OIDC support); study 1.7: Keycloak as the central SSO.
server_name: "{{ synapse_server_name }}"

oidc_providers:
  - idp_id: keycloak
    idp_name: "Libre365 SSO"
    issuer: "{{ keycloak_base_url }}/realms/{{ keycloak_target_realm }}"
    client_id: "{{ synapse_oidc_client_id }}"
    client_secret: "{{ synapse_oidc_client_secret }}"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        localpart_template: "{{ '{{' }} user.preferred_username {{ '}}' }}"
        display_name_template: "{{ '{{' }} user.name {{ '}}' }}"
    skip_verification: false
