# Copy to inventory/hosts.ini, or generate automatically from the Terraform
# outputs (see scripts/render-inventory-from-terraform.sh) rather than
# maintaining this file by hand in production — study 4.5: Terraform
# provisioning, Ansible configuration, in the same repository.

[grommunio]
grommunio-vm ansible_host=10.10.0.10 ansible_user=root

[k8s_control_plane]
k8s-cp-1 ansible_host=10.10.0.21 ansible_user=debian
k8s-cp-2 ansible_host=10.10.0.22 ansible_user=debian
k8s-cp-3 ansible_host=10.10.0.23 ansible_user=debian

[k8s_workers]
# Populated dynamically (variable count depending on deployment_scale, see
# infra/terraform/locals.tf) — static example for the "100" scale (3 workers).
k8s-worker-1 ansible_host=10.10.0.31 ansible_user=debian
k8s-worker-2 ansible_host=10.10.0.32 ansible_user=debian
k8s-worker-3 ansible_host=10.10.0.33 ansible_user=debian

[k8s_control_plane:vars]
ansible_python_interpreter=/usr/bin/python3

[k8s_workers:vars]
ansible_python_interpreter=/usr/bin/python3

# The "localhost" host carries the playbooks that only drive remote APIs
# (Keycloak REST, Matrix admin API) without needing an SSH connection.
[control_apis]
localhost ansible_connection=local

[keycloak:children]
control_apis

[matrix:children]
control_apis

[seafile:children]
control_apis

[onlyoffice:children]
control_apis
