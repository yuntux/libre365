# Généré par le rôle keycloak_realm — NE PAS COMMITTER (répertoire secrets/
# exclu du dépôt). À charger par le connecteur/service correspondant, ou à
# transférer vers le coffre-fort de secrets (étude 4.5).
KEYCLOAK_CLIENT_ID={{ item.item.client_id }}
KEYCLOAK_CLIENT_SECRET={{ item.client_secret_info.value | default('') }}
KEYCLOAK_ISSUER_URL={{ keycloak_base_url }}/realms/{{ keycloak_realm_name }}
