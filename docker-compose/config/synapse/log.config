# Log config minimal pour l'environnement dev/test (etude 4.6) : sortie
# console uniquement, niveau INFO, pas de rotation de fichiers (conteneur
# ephemere en CI).
version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  synapse.storage.SQL:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
