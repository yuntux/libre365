# Dev/test reverse proxy Caddyfile (study 4.6).
# In production (Kubernetes, study 4.4) the cross-cutting application portal
# (menu bar + notification bell + search, study 2.3) is provided by
# Caddy + an HTML injection plugin (e.g. caddy2-html-injection-plugin) that
# rewrites each application's HTML on the fly to insert this bar,
# without touching the applications' code (study 2.3, line "HTML injection
# on the reverse proxy side"). Here, in dev/test, Caddy only does a simple
# reverse proxy by sub-path to each building block, WITHOUT the injection
# plugin (not compiled into the official caddy:2-alpine image - a custom
# Caddy image built with `xcaddy build --with ...` would be needed, out of
# scope for a lightweight test environment). The snippet below documents
# what the production injection would look like, for reference only.

{
	admin off
}

:80 {
	# --- Portal: root redirect to Element (reference client) ---
	redir / /chat/ 302

	# --- Cross-cutting application bar (study 2.3) --------------------------
	# In PRODUCTION only (not active here), the injection snippet would
	# look like this (requires the caddy2-html-injection-plugin, absent
	# from the standard caddy:2-alpine image):
	#
	# route /chat/* {
	#     reverse_proxy element:80
	#     html_injection {
	#         selector "body"
	#         position "prepend"
	#         html `<div id="libre365-banner">...menu, cloche, recherche...</div>`
	#     }
	# }

	handle_path /chat/* {
		reverse_proxy element:80
	}

	handle_path /keycloak/* {
		reverse_proxy keycloak:8080
	}

	handle_path /matrix/* {
		reverse_proxy synapse:8008
	}

	handle_path /files/* {
		reverse_proxy seafile:80
	}

	handle_path /office/* {
		reverse_proxy onlyoffice-documentserver:80
	}

	handle_path /tasks/* {
		reverse_proxy vikunja:3456
	}

	handle_path /share/* {
		reverse_proxy gokapi:53842
	}

	handle_path /video/* {
		reverse_proxy peertube:9000
	}

	handle_path /s3/* {
		reverse_proxy minio:9000
	}

	handle {
		respond "libre365 dev portal - see docker-compose/README.md for the per-service ports" 200
	}

	log {
		output stdout
		format console
	}
}
