# =============================================================================
# libre365 - Development/test docker-compose environment (study, 4.6)
# =============================================================================
# Copy this file to `.env` before `docker compose up -d`.
#
# ALL the password/secret values below are DEVELOPMENT-ONLY values. Never
# reuse them in staging/production: the target secrets management approach
# goes through a dedicated vault (study, 4.5).
# =============================================================================

# --- Ports exposed on localhost (overridable in case of local conflict) ----
# BEGIN GENERATED PORTS (platform.yaml)
# Ce bloc est généré depuis platform.yaml par scripts/sync_platform.py.
# Ne pas éditer à la main : modifier platform.yaml puis relancer le script.
KEYCLOAK_PORT=8080
SYNAPSE_CLIENT_PORT=8008
SYNAPSE_FEDERATION_PORT=8448
ELEMENT_PORT=8081
SEAFILE_PORT=8082
ONLYOFFICE_PORT=8083
VIKUNJA_PORT=3456
GOKAPI_PORT=53842
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PEERTUBE_PORT=9002
CADDY_HTTP_PORT=10080
CADDY_HTTPS_PORT=10443
GROMMUNIO_DEV_HTTP_PORT=8443
NOTIFICATION_HUB_PORT=4001
UNIFIED_SEARCH_PORT=4002
PRESENCE_AGGREGATOR_PORT=4003
ONLYOFFICE_MENTIONS_PORT=4004
PEERTUBE_INGEST_PORT=4005
POSTGRES_KEYCLOAK_PORT=5433
POSTGRES_SYNAPSE_PORT=5434
POSTGRES_ONLYOFFICE_PORT=5435
NOVU_MOCK_PORT=13000
# END GENERATED PORTS

# --- Keycloak (study 1.7 / 4.5 / 4.6) ---------------------------------------
# Admin account for the "master" realm, created on startup in dev mode (start-dev).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=devonly-changeme-admin   # dev only, never use in prod
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=devonly-changeme-keycloak-db  # dev only, never use in prod
# Realm/client used by the tests/integration suite (see realm-export.json)
KEYCLOAK_REALM=libre365
KEYCLOAK_TEST_CLIENT_ID=libre365-integration-tests
KEYCLOAK_TEST_CLIENT_SECRET=devonly-changeme-client-secret  # dev only, never use in prod
KEYCLOAK_TEST_USER=testuser
KEYCLOAK_TEST_USER_PASSWORD=devonly-changeme-testuser  # dev only, never use in prod

# --- Postgres Synapse (study 1.2) -------------------------------------------
SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=devonly-changeme-synapse-db  # dev only, never use in prod
SYNAPSE_SERVER_NAME=matrix.libre365.localhost
SYNAPSE_REGISTRATION_SHARED_SECRET=devonly-changeme-synapse-registration  # dev only, never use in prod
SYNAPSE_MACAROON_SECRET_KEY=devonly-changeme-synapse-macaroon  # dev only, never use in prod
SYNAPSE_FORM_SECRET=devonly-changeme-synapse-form  # dev only, never use in prod

# --- Postgres OnlyOffice (study 1.5) ----------------------------------------
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=devonly-changeme-onlyoffice-db  # dev only, never use in prod
ONLYOFFICE_JWT_SECRET=devonly-changeme-onlyoffice-jwt  # dev only, never use in prod

# --- Seafile (study 1.4) -----------------------------------------------------
SEAFILE_ADMIN_EMAIL=admin@libre365.localhost
SEAFILE_ADMIN_PASSWORD=devonly-changeme-seafile-admin  # dev only, never use in prod
# Seafile-mc embeds its own internal MariaDB/memcached in "simplified
# compose" single-container mode (see docker-compose README: dedicated
# databases for Keycloak/Synapse/OnlyOffice, but Seafile keeps its internal
# database by default here to stick with a simple assembly of official
# images - to be revisited if it is ever aligned with a dedicated external
# Postgres/MariaDB).

# --- Vikunja (study 1.6) -----------------------------------------------------
VIKUNJA_JWT_SECRET=devonly-changeme-vikunja-jwt  # dev only, never use in prod

# --- Gokapi (study 1.8) -------------------------------------------------------
GOKAPI_ADMIN_USER=admin
GOKAPI_ADMIN_PASSWORD=devonly-changeme-gokapi-admin  # dev only, never use in prod

# --- MinIO (study 2.12) -------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=devonly-changeme-minio-root  # dev only, never use in prod

# --- PeerTube (study 2.12) ----------------------------------------------------
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USER=peertube
PEERTUBE_DB_PASSWORD=devonly-changeme-peertube-db  # dev only, never use in prod
PEERTUBE_ADMIN_EMAIL=admin@libre365.localhost
PEERTUBE_SECRET=devonly-changeme-peertube-secret  # dev only, never use in prod

# --- Grommunio (dev/test only, see README - NOT the production mode) -------
GROMMUNIO_ADMIN_PASSWORD=devonly-changeme-grommunio-admin  # dev only, never use in prod
GROMMUNIO_TIMEZONE=Europe/Paris
