# =============================================================================
# open365 - Environnement docker-compose de developpement/test (etude, 4.6)
# =============================================================================
# Copier ce fichier en `.env` avant `docker compose up -d`.
#
# TOUTES les valeurs de mots de passe/secrets ci-dessous sont des valeurs de
# DEVELOPPEMENT UNIQUEMENT. Ne jamais les reutiliser en recette/production :
# la gestion des secrets cible passe par un coffre-fort dedie (etude, 4.5).
# =============================================================================

# --- Ports exposes sur localhost (modifiable en cas de conflit local) -------
KEYCLOAK_PORT=8080
POSTGRES_KEYCLOAK_PORT=5433
POSTGRES_SYNAPSE_PORT=5434
POSTGRES_ONLYOFFICE_PORT=5435
SYNAPSE_CLIENT_PORT=8008
SYNAPSE_FEDERATION_PORT=8448
ELEMENT_PORT=8081
SEAFILE_PORT=8082
ONLYOFFICE_PORT=8083
VIKUNJA_PORT=3456
GOKAPI_PORT=53842
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PEERTUBE_PORT=9002
CADDY_HTTP_PORT=10080
CADDY_HTTPS_PORT=10443
NOVU_MOCK_PORT=13000
GROMMUNIO_DEV_HTTP_PORT=8443
NOTIFICATION_HUB_PORT=4001
UNIFIED_SEARCH_PORT=4002
PRESENCE_AGGREGATOR_PORT=4003
ONLYOFFICE_MENTIONS_PORT=4004
PEERTUBE_INGEST_PORT=4005

# --- Keycloak (etude 1.7 / 4.5 / 4.6) ---------------------------------------
# Compte admin du realm "master", cree au demarrage en mode dev (start-dev).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=devonly-changeme-admin   # dev only, ne jamais utiliser en prod
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=devonly-changeme-keycloak-db  # dev only, ne jamais utiliser en prod
# Realm/client utilises par la suite tests/integration (voir realm-export.json)
KEYCLOAK_REALM=open365
KEYCLOAK_TEST_CLIENT_ID=open365-integration-tests
KEYCLOAK_TEST_CLIENT_SECRET=devonly-changeme-client-secret  # dev only, ne jamais utiliser en prod
KEYCLOAK_TEST_USER=testuser
KEYCLOAK_TEST_USER_PASSWORD=devonly-changeme-testuser  # dev only, ne jamais utiliser en prod

# --- Postgres Synapse (etude 1.2) -------------------------------------------
SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=devonly-changeme-synapse-db  # dev only, ne jamais utiliser en prod
SYNAPSE_SERVER_NAME=matrix.open365.localhost
SYNAPSE_REGISTRATION_SHARED_SECRET=devonly-changeme-synapse-registration  # dev only, ne jamais utiliser en prod
SYNAPSE_MACAROON_SECRET_KEY=devonly-changeme-synapse-macaroon  # dev only, ne jamais utiliser en prod
SYNAPSE_FORM_SECRET=devonly-changeme-synapse-form  # dev only, ne jamais utiliser en prod

# --- Postgres OnlyOffice (etude 1.5) ----------------------------------------
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=devonly-changeme-onlyoffice-db  # dev only, ne jamais utiliser en prod
ONLYOFFICE_JWT_SECRET=devonly-changeme-onlyoffice-jwt  # dev only, ne jamais utiliser en prod

# --- Seafile (etude 1.4) -----------------------------------------------------
SEAFILE_ADMIN_EMAIL=admin@open365.localhost
SEAFILE_ADMIN_PASSWORD=devonly-changeme-seafile-admin  # dev only, ne jamais utiliser en prod
# Seafile-mc embarque son propre MariaDB/memcached internes en mode "compose
# simplifie" mono-conteneur (cf. README docker-compose : bases dediees pour
# Keycloak/Synapse/OnlyOffice, mais Seafile garde sa base interne par defaut
# ici pour rester sur un assemblage simple d'images officielles - a
# revisiter si un jour aligne sur une Postgres/MariaDB dediee externe).

# --- Vikunja (etude 1.6) -----------------------------------------------------
VIKUNJA_JWT_SECRET=devonly-changeme-vikunja-jwt  # dev only, ne jamais utiliser en prod

# --- Gokapi (etude 1.8) -------------------------------------------------------
GOKAPI_ADMIN_USER=admin
GOKAPI_ADMIN_PASSWORD=devonly-changeme-gokapi-admin  # dev only, ne jamais utiliser en prod

# --- MinIO (etude 2.12) -------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=devonly-changeme-minio-root  # dev only, ne jamais utiliser en prod

# --- PeerTube (etude 2.12) ----------------------------------------------------
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USER=peertube
PEERTUBE_DB_PASSWORD=devonly-changeme-peertube-db  # dev only, ne jamais utiliser en prod
PEERTUBE_ADMIN_EMAIL=admin@open365.localhost
PEERTUBE_SECRET=devonly-changeme-peertube-secret  # dev only, ne jamais utiliser en prod

# --- Grommunio (dev/test uniquement, cf. README - PAS le mode de prod) ------
GROMMUNIO_ADMIN_PASSWORD=devonly-changeme-grommunio-admin  # dev only, ne jamais utiliser en prod
GROMMUNIO_TIMEZONE=Europe/Paris
